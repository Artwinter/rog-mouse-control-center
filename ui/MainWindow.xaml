<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外设控制中心" Width="1200" Height="780"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI">

  <Window.Resources>
    <SolidColorBrush x:Key="Void" Color="#080A0B"/>
    <SolidColorBrush x:Key="Panel" Color="#101415"/>
    <SolidColorBrush x:Key="PanelRaised" Color="#14191A"/>
    <SolidColorBrush x:Key="Line" Color="#293032"/>
    <SolidColorBrush x:Key="LineSoft" Color="#1B2223"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F0EA"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#89938F"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#5B6561"/>
    <SolidColorBrush x:Key="SignalRed" Color="#FF4655"/>
    <SolidColorBrush x:Key="SignalGreen" Color="#79FF5A"/>
    <SolidColorBrush x:Key="SignalAmber" Color="#FFBD62"/>
    <SolidColorBrush x:Key="PanelGreen" Color="#101A13"/>
    <SolidColorBrush x:Key="PanelRed" Color="#1A1012"/>
    <LinearGradientBrush x:Key="MouseGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF4655" Offset="0"/>
      <GradientStop Color="#FF7A3D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SignalGradient" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#79FF5A" Offset="0"/>
      <GradientStop Color="#B5FF8A" Offset="1"/>
    </LinearGradientBrush>
    <DrawingBrush x:Key="GridPattern" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#080A0B" Geometry="M0,0 H28 V28 H0 Z"/>
          <GeometryDrawing Brush="{x:Null}" Geometry="M0,0 H28 M0,0 V28">
            <GeometryDrawing.Pen><Pen Brush="#14FFFFFF" Thickness="1"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="BarTicks" TileMode="Tile" Viewport="0,0,13,10" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="{x:Null}" Geometry="M12.5,0 V10">
            <GeometryDrawing.Pen><Pen Brush="#30101415" Thickness="1"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="UtilityLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Bahnschrift"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="InstrumentPanel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#16FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DeviceItem" TargetType="Button">
      <Setter Property="Height" Value="76"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="signal" Width="2" HorizontalAlignment="Left" Background="Transparent"/>
              <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2">
                <ContentPresenter Margin="18,0,10,0" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#101719"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#263233"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="signal" Property="Background" Value="{StaticResource SignalGreen}"/>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelRaised}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#31413A"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Height" Value="31"/>
      <Setter Property="MinWidth" Value="66"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Padding" Value="13,0"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="2" Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#18FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource MouseGradient}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GreenChip" TargetType="Button">
      <Setter Property="Height" Value="31"/>
      <Setter Property="MinWidth" Value="66"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Padding" Value="13,0"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="2" Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1644D62C"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource SignalGradient}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#071006"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegChip" TargetType="Button">
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="2" Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="6,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#18FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource MouseGradient}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuickChip" TargetType="Button" BasedOn="{StaticResource Chip}">
      <Setter Property="Height" Value="27"/>
      <Setter Property="MinWidth" Value="45"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="2" Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#18FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SignalButton" TargetType="Button">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Foreground" Value="{StaticResource SignalGreen}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="2" Background="#0D79FF5A" BorderBrush="#4779FF5A" BorderThickness="1">
              <Grid Margin="14,0">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="RESYNC  ↗" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="Bahnschrift" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1879FF5A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent">
              <Border Height="4" CornerRadius="0" Background="{StaticResource MouseGradient}" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderEmpty" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent">
              <Border Height="4" Background="#20FFFFFF" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid>
              <Ellipse Width="16" Height="16" Fill="{StaticResource SignalRed}"/>
              <Ellipse Width="5" Height="5" Fill="#FFFFFF"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TacticalSlider" TargetType="Slider">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center" Background="Transparent">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TacticalToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="track" CornerRadius="2" Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
              <Ellipse x:Name="knob" Width="16" Height="16" Fill="#B6C0BC" HorizontalAlignment="Left" Margin="3,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="knobShift" X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#2579FF5A"/>
                <Setter TargetName="track" Property="BorderBrush" Value="#6679FF5A"/>
                <Setter TargetName="knob" Property="Fill" Value="{StaticResource SignalGreen}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="knobShift" Storyboard.TargetProperty="X" To="23" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="knobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" CornerRadius="0" Background="{StaticResource Void}" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid ClipToBounds="True">
      <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.42" IsHitTestVisible="False"/>
      <Ellipse Width="700" Height="460" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-270,0,0" IsHitTestVisible="False">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#20FF4655" Offset="0"/><GradientStop Color="#00FF4655" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="620" Height="420" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-250,-260" IsHitTestVisible="False">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1679FF5A" Offset="0"/><GradientStop Color="#0079FF5A" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      </Ellipse>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="62"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Background="#C0080A0B">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
            <Border Width="8" Height="8" Background="{StaticResource SignalRed}" VerticalAlignment="Center"/>
            <TextBlock Text="PERIPHERAL CONTROL" Margin="12,0,0,0" FontFamily="Bahnschrift" FontSize="12"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            <TextBlock Text="// INSTRUMENT 02" Margin="8,0,0,0" FontFamily="Bahnschrift" FontSize="9"
                       Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
              <Border Width="5" Height="5" CornerRadius="3" Background="{StaticResource SignalRed}" VerticalAlignment="Center"/>
              <TextBlock Text="ROG KERIS 2.4G" Margin="7,0,16,0" FontFamily="Bahnschrift" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
              <Border Width="5" Height="5" CornerRadius="3" Background="{StaticResource SignalGreen}" VerticalAlignment="Center"/>
              <TextBlock Text="BLACKSHARK 2.4G" Margin="7,0,0,0" FontFamily="Bahnschrift" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
            <Button x:Name="BtnMin" Style="{StaticResource ChromeButton}">
              <Path Data="M0,5 L10,5" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.1"/>
            </Button>
            <Button x:Name="BtnClose" Style="{StaticResource ChromeButton}" Margin="2,0,0,0">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.1"/>
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Background="#A0080A0B">
            <Grid Margin="20,28,20,18">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="DEVICE BUS / 02" Style="{StaticResource UtilityLabel}" Margin="0,0,0,14"/>

              <Button x:Name="TabMouse" Grid.Row="1" Style="{StaticResource DeviceItem}" Tag="on">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="42" Height="42" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#0A0D0E">
                    <Viewbox Width="28" Height="28">
                      <Path Data="M15,3 C8,3 5,8 5,15 L5,20 C5,25 9,28 15,28 C21,28 25,25 25,20 L25,15 C25,8 22,3 15,3 Z M15,4 L15,13"
                            Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4" Fill="Transparent"/>
                    </Viewbox>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="01 / MOUSE" FontFamily="Bahnschrift" FontSize="8" Foreground="{StaticResource TextTertiary}"/>
                    <TextBlock Text="月刃 AimPoint" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0"/>
                    <TextBlock Text="CONNECTED" FontFamily="Bahnschrift" FontSize="8" Foreground="{StaticResource SignalGreen}" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Button>

              <Button x:Name="TabHeadset" Grid.Row="2" Style="{StaticResource DeviceItem}" Tag="off">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="42" Height="42" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#0A0D0E">
                    <Viewbox Width="30" Height="30">
                      <Path Data="M7,23 L7,19 C7,10 12,5 20,5 C28,5 33,10 33,19 L33,23 M5,20 L11,20 L11,32 L5,32 Z M29,20 L35,20 L35,32 L29,32 Z M31,31 C30,36 26,38 21,38 L17,38 M16,38 A2,2 0 1 0 12,38 A2,2 0 1 0 16,38"
                            Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4" Fill="Transparent"/>
                    </Viewbox>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="02 / HEADSET" FontFamily="Bahnschrift" FontSize="8" Foreground="{StaticResource TextTertiary}"/>
                    <TextBlock Text="旋风黑鲨 V2 Pro" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0"/>
                    <TextBlock Text="LINK STABLE" FontFamily="Bahnschrift" FontSize="8" Foreground="{StaticResource TextTertiary}" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Button>

              <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                <StackPanel>
                  <TextBlock Text="POWER CELL / ROG" Style="{StaticResource UtilityLabel}" Margin="0,0,0,10"/>
                  <Grid Width="88" Height="88" HorizontalAlignment="Left">
                    <Ellipse Width="88" Height="88" Stroke="#20FFFFFF" StrokeThickness="7"/>
                    <Path x:Name="BatteryArc" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{StaticResource SignalRed}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock x:Name="BatteryValue" Text="--" FontFamily="Bahnschrift" FontSize="24" FontWeight="Light"
                                 Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                      <TextBlock Text="BATTERY %" FontFamily="Bahnschrift" FontSize="7" Foreground="{StaticResource TextTertiary}"
                                 HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="BatteryHint" Text="正在读取…" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                  <TextBlock Text="READ ONLY / SERVICE LOOP" FontFamily="Bahnschrift" FontSize="8" Foreground="{StaticResource TextTertiary}" Margin="0,16,0,0"/>
                  <TextBlock Text="每次查询后释放 HID 句柄" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.Column="1" Margin="32,26,32,18">
            <Grid x:Name="MousePage">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                  <TextBlock Text="MOUSE / 2.4 GHZ RECEIVER" FontFamily="Bahnschrift" FontSize="9" Foreground="{StaticResource SignalRed}"/>
                  <TextBlock x:Name="DeviceName" Text="ROG 月刃 AimPoint 36K" FontSize="27" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}" Margin="0,7,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Border x:Name="StatusDot" Width="6" Height="6" CornerRadius="3" Background="{StaticResource SignalGreen}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ConnText" Text="2.4 GHz 接收器" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                  </StackPanel>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#0DFF4655" BorderBrush="#4DFF4655" BorderThickness="1" Padding="10,7">
                  <TextBlock Text="● LIVE TELEMETRY" FontFamily="Bahnschrift" FontSize="8" Foreground="{StaticResource SignalRed}"/>
                </Border>
              </Grid>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.12*"/>
                  <ColumnDefinition Width="18"/>
                  <ColumnDefinition Width="0.88*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InstrumentPanel}">
                  <Grid Margin="18,16,18,16">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="128"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                      <StackPanel>
                        <TextBlock Text="DPI / SENSITIVITY" Style="{StaticResource UtilityLabel}"/>
                        <TextBlock Text="指针灵敏度" FontSize="15" Foreground="{StaticResource TextPrimary}" Margin="0,7,0,0"/>
                      </StackPanel>
                      <Border Width="168" Height="76" HorizontalAlignment="Right" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#0A0D0E">
                        <Grid ClipToBounds="True">
                          <Image x:Name="HeroImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.92"/>
                          <Border IsHitTestVisible="False">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0A0D0E" Offset="0"/>
                                <GradientStop Color="#000A0D0E" Offset="0.22"/>
                                <GradientStop Color="#000A0D0E" Offset="0.82"/>
                                <GradientStop Color="#FF0A0D0E" Offset="1"/>
                              </LinearGradientBrush>
                            </Border.Background>
                          </Border>
                        </Grid>
                      </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,22,0,0">
                      <Grid VerticalAlignment="Bottom" Height="110">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="220"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DpiValue" Grid.Column="0" Text="--" FontFamily="Segoe UI" FontSize="86"
                                   FontWeight="Normal" Foreground="#FFFFFFFF" Background="{StaticResource Panel}"
                                   TextOptions.TextRenderingMode="Grayscale" VerticalAlignment="Bottom"/>
                        <TextBlock Grid.Column="1" Text="DPI" FontFamily="Bahnschrift" FontSize="16"
                                   Foreground="{StaticResource TextTertiary}" Margin="8,0,0,15" VerticalAlignment="Bottom"/>
                      </Grid>
                      <TextBlock Text="CURRENT STAGE" FontFamily="Bahnschrift" FontSize="9"
                                 Foreground="{StaticResource SignalRed}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
                    </Grid>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                      <StackPanel x:Name="StagePanel" Orientation="Horizontal" Margin="0,8,0,0"/>
                      <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="DpiSlider" Style="{StaticResource TacticalSlider}" Minimum="100" Maximum="36000"
                                SmallChange="50" LargeChange="50" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                          <Button x:Name="BtnMinus" Style="{StaticResource ChromeButton}" Width="28" Height="28">
                            <Path Data="M0,5 L10,5" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2"/>
                          </Button>
                          <Button x:Name="BtnPlus" Style="{StaticResource ChromeButton}" Width="28" Height="28" Margin="3,0,0,0">
                            <Path Data="M5,0 L5,10 M0,5 L10,5" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2"/>
                          </Button>
                        </StackPanel>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="常用" FontSize="10.5" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="Quick400" Style="{StaticResource QuickChip}" Content="400"/>
                        <Button x:Name="Quick800" Style="{StaticResource QuickChip}" Content="800"/>
                        <Button x:Name="Quick1600" Style="{StaticResource QuickChip}" Content="1600"/>
                        <Button x:Name="Quick2400" Style="{StaticResource QuickChip}" Content="2400"/>
                        <Button x:Name="Quick3200" Style="{StaticResource QuickChip}" Content="3200"/>
                      </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                      <Grid>
                        <TextBlock Text="LIVE / 50 DPI STEP · WHEEL SUPPORTED" FontFamily="Bahnschrift" FontSize="8" Foreground="{StaticResource TextTertiary}"/>
                        <TextBlock x:Name="SaveHint" Text="等待设备…" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource InstrumentPanel}">
                  <Grid Margin="18,16,18,16">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                      <TextBlock Text="RESPONSE / CONTROL" Style="{StaticResource UtilityLabel}"/>
                      <TextBlock Text="响应与系统" FontSize="15" Foreground="{StaticResource TextPrimary}" Margin="0,7,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,20,0,0">
                      <StackPanel>
                        <TextBlock Text="轮询率" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="光标跟手程度" FontSize="9.5" Foreground="{StaticResource TextTertiary}" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel x:Name="RatePanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                      <StackPanel>
                        <TextBlock Text="按键响应 / MS" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="数值越大越不易误触" FontSize="9.5" Foreground="{StaticResource TextTertiary}" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel x:Name="DebouncePanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                      <StackPanel>
                        <TextBlock Text="直线修正" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="轨迹更接近水平或垂直" FontSize="9.5" Foreground="{StaticResource TextTertiary}" Margin="0,4,0,0"/>
                      </StackPanel>
                      <ToggleButton x:Name="SnapToggle" Style="{StaticResource TacticalToggle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,16,0,0">
                      <StackPanel>
                        <TextBlock Text="开机自启动" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="登录 Windows 后静默运行" FontSize="9.5" Foreground="{StaticResource TextTertiary}" Margin="0,4,0,0"/>
                      </StackPanel>
                      <ToggleButton x:Name="AutostartToggle" Style="{StaticResource TacticalToggle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                      <StackPanel>
                        <TextBlock Text="FIRMWARE / DEVICE" Style="{StaticResource UtilityLabel}"/>
                        <TextBlock x:Name="InfoFirmware" Text="固件 --" FontFamily="Bahnschrift" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="6" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                      <TextBlock Text="每次调整写入设备并回读校验" FontSize="9.5" Foreground="{StaticResource TextTertiary}"/>
                    </Border>
                  </Grid>
                </Border>
              </Grid>

              <Border Grid.Row="2" Style="{StaticResource InstrumentPanel}" Margin="0,14,0,0" Padding="14,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"><TextBlock Text="CURRENT STAGE" Style="{StaticResource UtilityLabel}"/><TextBlock x:Name="SpecPreset" Text="--" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="POLLING" Style="{StaticResource UtilityLabel}"/><TextBlock x:Name="SpecRate" Text="--" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="DEBOUNCE" Style="{StaticResource UtilityLabel}"/><TextBlock x:Name="SpecDebounce" Text="--" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel Grid.Column="3"><TextBlock Text="TRANSPORT" Style="{StaticResource UtilityLabel}"/><TextBlock x:Name="SpecConn" Text="--" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel Grid.Column="4"><TextBlock Text="POWER" Style="{StaticResource UtilityLabel}"/><TextBlock x:Name="SpecCharge" Text="--" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/></StackPanel>
                </Grid>
              </Border>
            </Grid>

            <Border x:Name="HeadsetPage" Visibility="Collapsed" Background="Transparent">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,18">
                  <StackPanel>
                    <TextBlock Text="HEADSET / 2.4 GHZ RECEIVER" FontFamily="Bahnschrift" FontSize="9" Foreground="{StaticResource SignalGreen}"/>
                    <TextBlock Text="旋风黑鲨 V2 专业版" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,7,0,0"/>
                    <TextBlock x:Name="HeadsetConn" Text="Razer BlackShark V2 Pro · 2023" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0"/>
                  </StackPanel>
                  <Border x:Name="HeadsetStateBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Background="#0D79FF5A" BorderBrush="#4D79FF5A" BorderThickness="1" CornerRadius="2" Padding="11,7">
                    <TextBlock x:Name="HeadsetState" Text="● LIVE TELEMETRY" FontFamily="Bahnschrift" FontSize="8" Foreground="{StaticResource SignalGreen}"/>
                  </Border>
                </Grid>

                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="0.88*"/>
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Style="{StaticResource InstrumentPanel}">
                    <Grid Margin="18,16,18,16">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid Grid.Row="0">
                        <TextBlock Text="POWER CELL / LEVEL" Style="{StaticResource UtilityLabel}"/>
                        <TextBlock Text="READ ONLY" FontFamily="Bahnschrift" FontSize="8" Foreground="{StaticResource SignalGreen}" HorizontalAlignment="Right"/>
                      </Grid>

                      <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Viewbox Stretch="Fill" Opacity="0.34" VerticalAlignment="Bottom" Margin="0,0,0,18">
                          <Canvas Width="520" Height="80">
                            <Path Data="M0,63 L54,63 L86,57 L118,59 L150,50 L190,53 L224,43 L260,47 L296,38 L332,41 L368,35 L406,38 L442,31 L480,34 L520,28"
                                  Stroke="#79FF5A" StrokeThickness="1.3" Fill="Transparent"/>
                            <Path Data="M0,63 L54,63 L86,57 L118,59 L150,50 L190,53 L224,43 L260,47 L296,38 L332,41 L368,35 L406,38 L442,31 L480,34 L520,28 L520,80 L0,80 Z"
                                  Fill="#0D79FF5A" Stroke="Transparent"/>
                          </Canvas>
                        </Viewbox>
                        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="HeadsetBattery" Text="--" FontFamily="Bahnschrift" FontSize="132" FontWeight="Light"
                                       FontStretch="Condensed" Foreground="{StaticResource TextPrimary}" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text="%" FontFamily="Bahnschrift" FontSize="20" Foreground="{StaticResource TextSecondary}" Margin="6,0,0,15" VerticalAlignment="Bottom"/>
                          </StackPanel>
                          <TextBlock x:Name="HeadsetStatus" Text="正在读取耳机电量…" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                     HorizontalAlignment="Center" TextAlignment="Center" Margin="0,-10,0,0"/>
                          <Grid Height="10" Margin="0,20,0,0" HorizontalAlignment="Stretch">
                            <Border Background="#14FFFFFF" CornerRadius="1"/>
                            <Border x:Name="HeadsetBar" HorizontalAlignment="Left" Width="0" Background="{StaticResource SignalGradient}" CornerRadius="1"/>
                            <Rectangle Fill="{StaticResource BarTicks}" IsHitTestVisible="False"/>
                          </Grid>
                          <Grid Margin="0,6,0,0">
                            <TextBlock Text="0" Style="{StaticResource UtilityLabel}"/>
                            <TextBlock Text="25" Style="{StaticResource UtilityLabel}" HorizontalAlignment="Center" Margin="0,0,150,0"/>
                            <TextBlock Text="50" Style="{StaticResource UtilityLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="75" Style="{StaticResource UtilityLabel}" HorizontalAlignment="Center" Margin="150,0,0,0"/>
                            <TextBlock Text="100" Style="{StaticResource UtilityLabel}" HorizontalAlignment="Right"/>
                          </Grid>
                        </StackPanel>
                      </Grid>

                      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <Grid>
                          <TextBlock x:Name="HeadsetLastRead" Text="最后读取 --" Style="{StaticResource UtilityLabel}"/>
                          <TextBlock Text="REFRESH / 60 SEC" Style="{StaticResource UtilityLabel}" HorizontalAlignment="Right"/>
                        </Grid>
                      </Border>
                    </Grid>
                  </Border>

                  <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource InstrumentPanel}" Padding="16,14">
                      <StackPanel>
                        <TextBlock Text="CONNECTION / RECEIVER" Style="{StaticResource UtilityLabel}"/>
                        <Grid Margin="0,14,0,0"><TextBlock Text="连接方式" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="2.4 GHz 无线" FontFamily="Bahnschrift" FontSize="10" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,11,0,0"><TextBlock Text="接收器" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="HeadsetReceiver" Text="Razer USB 接收器" FontSize="10" Foreground="{StaticResource SignalGreen}" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,11,0,0"><TextBlock Text="电池状态" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="HeadsetPower" Text="--" FontSize="10" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/></Grid>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource InstrumentPanel}" Padding="16,14" Margin="0,12,0,0" Background="{StaticResource PanelGreen}" BorderBrush="#31413A">
                      <StackPanel>
                        <TextBlock Text="CONTROL BUS / READ ONLY" Style="{StaticResource UtilityLabel}"/>
                        <TextBlock Text="Razer PA protocol" FontFamily="Bahnschrift" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0"/>
                        <TextBlock Text="0x21 / BATTERY   0x2A / POWER" FontFamily="Bahnschrift" FontSize="9" Foreground="{StaticResource SignalGreen}" Margin="0,7,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource InstrumentPanel}" Padding="16,14" Margin="0,12,0,0">
                      <StackPanel>
                        <TextBlock Text="ACCESS POLICY" Style="{StaticResource UtilityLabel}"/>
                        <TextBlock Text="仅耳机页可见时访问设备。收起窗口、最小化或全屏游戏时暂停读取。" FontSize="10" Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="17"/>
                      </StackPanel>
                    </Border>
                    <Button x:Name="BtnHeadsetRefresh" Grid.Row="3" Style="{StaticResource SignalButton}" Content="重新读取耳机电量" Margin="0,12,0,0"/>
                  </Grid>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource InstrumentPanel}" Margin="0,14,0,0" Padding="14,10">
                  <Grid>
                    <TextBlock Text="BLACKSHARK V2 PRO / 2023 / 2.4G" Style="{StaticResource UtilityLabel}"/>
                    <TextBlock Text="LOCAL · NO CLOUD · NO SYNAPSE REQUIRED" Style="{StaticResource UtilityLabel}" HorizontalAlignment="Right"/>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,0">
          <TextBlock x:Name="FootStatus" Text="正在连接设备…" FontSize="10" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="BtnTrayDiag" Style="{StaticResource GhostButton}" Content="托盘诊断" Margin="0,0,8,0"/>
            <Button x:Name="BtnRefresh" Style="{StaticResource GhostButton}" Content="重新读取"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
